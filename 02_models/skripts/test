import pandas as pd
import numpy as np

path = ("01_data/04b_accumulated_data_per_node/Climate Data/Hydro Inflows/"
        "Pump storage - Open Loop/NO_accumulated.csv")

raw = pd.read_csv(path, header=None)

# Header-Zeile ist Zeile 12, erster Block startet bei Spalte 10
# Klimajahre 1982-2017 sind in Spalten 17-52 (erster Block)
# Finde alle Klimajahr-Spalten im ersten Block
years_to_check = [1990, 1992, 1993, 1995, 1996, 2000, 2002, 2005, 
                  2006, 2007, 2008, 2009, 2010, 2011, 2012]

print(f"{'Jahr':>6} {'Spalte':>7} {'Inflow Ø (MW)':>15} {'Inflow Max (MW)':>16} {'Bewertung':>12}")
print("-" * 60)

for year in years_to_check:
    # Finde Spalte
    col_idx = None
    for ci, val in enumerate(raw.iloc[12].values):
        try:
            if int(float(str(val))) == year and ci < 60:  # nur erster Block
                col_idx = ci
                break
        except:
            pass
    
    if col_idx is None:
        print(f"{year:>6} {'nicht gefunden':>7}")
        continue
    
    # Datenwerte ab Zeile 13
    values = pd.to_numeric(raw.iloc[13:, col_idx].values, errors="coerce")
    values = pd.Series(values).fillna(0).values[:53]
    
    # GWh/Woche → MW (wie in deinem Code)
    mw = values * 1000.0 / 168
    hourly = np.repeat(mw, 168)[:8760]
    
    avg = hourly.mean()
    mx = hourly.max()
    
    # Bewertung relativ zu Last-Ø NO (~19.800 MW)
    balance = avg - 19800
    bewertung = "✅ gut" if balance > 0 else ("🟡 knapp" if balance > -2000 else "🔴 schlecht")
    
    print(f"{year:>6} {col_idx:>7} {avg:>15.1f} {mx:>16.1f} {bewertung:>12}  (Δ={balance:+.0f} MW)")